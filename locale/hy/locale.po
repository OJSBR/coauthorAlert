#, fuzzy
msgid "plugins.generic.coauthorAlert.default.contributorsAlertText"
msgstr "<p>Աշխատանքը կատարվե՞լ է ղեկավարությամբ (ավարտական աշխատանք, թեզ կամ բակալավրիատի հոդված)։ Ավելացրեք ձեր գիտական ղեկավարին որպես համահեղինակ <strong>այս քայլում</strong>։</p><p>Ներկայացումից հետո հեղինակների ցանկը հնարավոր չէ փոխել, և ամսագիրը պետք է սկզբից իմանա, թե ով է ձեր ղեկավարը, որպեսզի նրան երբեք չհրավիրի գրախոսելու սեփական ուսանողի աշխատանքը, ինչը կվտանգեր կրկնակի անանուն գրախոսությունը։ Առանց ղեկավարին որպես համահեղինակ ավելացնելու՝ աշխատանքը նաև չի կարող հաստատվել որպես ավարտական աշխատանք։</p>"

#, fuzzy
msgid "plugins.generic.coauthorAlert.default.soloWarning"
msgstr "Այս ներկայացումն ունի միայն մեկ հեղինակ։ Եթե աշխատանքը կատարվել է ղեկավարությամբ, ավելացրեք ձեր գիտական ղեկավարին որպես համահեղինակ հիմա։"

#, fuzzy
msgid "plugins.generic.coauthorAlert.default.soloOk"
msgstr "Համահեղինակներն ավելացված են։ Համոզվեք, որ ձեր գիտական ղեկավարը նրանց թվում է։"

#, fuzzy
msgid "plugins.generic.coauthorAlert.default.reviewAlertTitle"
msgstr "Վերջին հնարավորությունը՝ ավելացնելու ձեր գիտական ղեկավարին որպես համահեղինակ"

#, fuzzy
msgid "plugins.generic.coauthorAlert.default.reviewAlertText"
msgstr "<p>Ներկայացումից հետո հեղինակների ցանկն այլևս հնարավոր չի լինի փոխել։ Եթե աշխատանքը կատարվել է ղեկավարությամբ, և ձեր ղեկավարը վերևում նշված չէ, սեղմեք Խմբագրել Աջակիցներ վահանակում. հակառակ դեպքում աշխատանքը չի կարող հաստատվել որպես ավարտական աշխատանք, և ձեր ղեկավարը կարող է հրավիրվել այն գրախոսելու՝ վտանգելով կրկնակի անանուն գրախոսությունը։</p>"

#, fuzzy
msgid "plugins.generic.coauthorAlert.default.confirmLabel"
msgstr "<p>Ես ստուգել եմ հեղինակների ցանկը։ Եթե այս աշխատանքը կատարվել է ղեկավարությամբ, իմ գիտական ղեկավարը նշված է որպես համահեղինակ։ Ես հասկանում եմ, որ ներկայացումից հետո համահեղինակներ ավելացնել հնարավոր չէ։</p>"

#, fuzzy
msgid "plugins.generic.coauthorAlert.default.confirmError"
msgstr "Խնդրում ենք նշել վերևի հաստատումը՝ ներկայացումն ավարտելու համար։"
