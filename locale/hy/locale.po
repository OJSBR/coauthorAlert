#, fuzzy
msgid "plugins.generic.coauthorAlert.description"
msgstr "Ներկայացման գործընթացի աջակիցների քայլում և վերջնական վերանայման քայլում ցուցադրում է ընդգծված ծանուցումներ, որոնք հիշեցնում են ղեկավարությամբ կատարված աշխատանքների հեղինակներին ավելացնել իրենց գիտական ղեկավարին որպես համահեղինակ, և պահանջում է հաստատում՝ նախքան ներկայացնելը։ Բոլոր տեքստերը կարգավորելի են և բազմալեզու։"

#, fuzzy
msgid "plugins.generic.coauthorAlert.settings.description"
msgstr "Ստորև դաշտերը նախապես լրացված են լռելյայն ձևակերպմամբ ամսագրի յուրաքանչյուր լեզվով և կարող են ազատորեն փոփոխվել։ Եթե դաշտը դատարկ մնա, կօգտագործվի պլագինի լռելյայն տեքստը։"

