msgid "plugins.generic.coauthorAlert.description"
msgstr "Wyświetla wyraźne komunikaty w kroku Autorzy oraz w końcowym kroku przeglądu kreatora zgłoszenia, przypominając autorom prac pisanych pod kierunkiem promotora, aby dodali go jako współautora, i wymaga potwierdzenia przed wysłaniem. Wszystkie teksty są konfigurowalne i wielojęzyczne."

#, fuzzy
msgid "plugins.generic.coauthorAlert.settings.description"
