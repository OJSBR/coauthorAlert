#, fuzzy
msgid "plugins.generic.coauthorAlert.default.reviewAlertText"
msgstr "<p>შენატანის შემდეგ ავტორთა სიის შეცვლა აღარ იქნება შესაძლებელი. თუ ნაშრომი ხელმძღვანელის ზედამხედველობით შესრულდა და თქვენი ხელმძღვანელი ზემოთ არ ჩანს, დააწკაპეთ ჩასწორება მონაწილეების პანელში: წინააღმდეგ შემთხვევაში ნაშრომი არ შეიძლება ჩაითვლოს დიპლომურ ნაშრომად, და თქვენი ხელმძღვანელი შეიძლება მოიწვიონ მის რეცენზენტად, რაც ორმხრივ ანონიმურ რეცენზირებას დააზიანებს.</p>"

#, fuzzy
msgid "plugins.generic.coauthorAlert.default.confirmLabel"
msgstr "<p>ავტორთა სია გადავამოწმე. თუ ეს ნაშრომი ხელმძღვანელის ზედამხედველობით შესრულდა, ჩემი ხელმძღვანელი თანაავტორად არის მითითებული. მესმის, რომ შენატანის შემდეგ თანაავტორების დამატება შეუძლებელია.</p>"

#, fuzzy
msgid "plugins.generic.coauthorAlert.default.confirmError"
msgstr "შენატანის დასრულებლად მონიშნეთ ზემოთ მოცემული დადასტურება."
