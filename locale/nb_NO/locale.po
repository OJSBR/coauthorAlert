#, fuzzy
msgid "plugins.generic.coauthorAlert.default.contributorsAlertTitle"
msgstr "Veiledet arbeid? Legg til veilederen din som medforfatter nå"

#, fuzzy
msgid "plugins.generic.coauthorAlert.default.contributorsAlertText"
msgstr "<p>Er dette et veiledet arbeid (avsluttende oppgave, masteroppgave eller bacheloroppgave)? Legg til veilederen din som medforfatter <strong>i dette trinnet</strong>.</p><p>Etter innlevering kan forfatterlisten ikke endres, og tidsskriftet må vite fra starten hvem veilederen din er, slik at veilederen aldri blir invitert til å vurdere arbeidet til sin egen student, noe som ville svekke den dobbelt anonyme fagfellevurderingen. Uten veilederen som medforfatter kan arbeidet heller ikke godkjennes som avsluttende oppgave.</p>"

#, fuzzy
msgid "plugins.generic.coauthorAlert.default.soloWarning"
msgstr "Denne innleveringen har bare én forfatter. Hvis arbeidet var veiledet, legg til veilederen din som medforfatter nå."

#, fuzzy
msgid "plugins.generic.coauthorAlert.default.soloOk"
msgstr "Medforfattere lagt til. Kontroller at veilederen din er blant dem."

#, fuzzy
msgid "plugins.generic.coauthorAlert.default.reviewAlertTitle"
msgstr "Siste sjanse til å legge til veilederen din som medforfatter"

#, fuzzy
msgid "plugins.generic.coauthorAlert.default.reviewAlertText"
msgstr "<p>Etter innlevering kan forfatterlisten ikke lenger endres. Hvis arbeidet var veiledet og veilederen din ikke står oppført ovenfor, klikk på Rediger i panelet Bidragsytere: ellers kan arbeidet ikke godkjennes som avsluttende oppgave, og veilederen din kan bli invitert til å vurdere det, noe som svekker den dobbelt anonyme fagfellevurderingen.</p>"

#, fuzzy
msgid "plugins.generic.coauthorAlert.default.confirmLabel"
msgstr "<p>Jeg har kontrollert forfatterlisten. Hvis dette arbeidet var veiledet, står veilederen min oppført som medforfatter. Jeg forstår at medforfattere ikke kan legges til etter innlevering.</p>"

#, fuzzy
msgid "plugins.generic.coauthorAlert.default.confirmError"
msgstr "Kryss av for bekreftelsen ovenfor for å fullføre innleveringen."
