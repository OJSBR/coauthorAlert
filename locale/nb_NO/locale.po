#, fuzzy
msgid "plugins.generic.coauthorAlert.displayName"
msgstr "Varsel om medforfatter og veileder"

#, fuzzy
msgid "plugins.generic.coauthorAlert.description"
msgstr "Viser tydelige varsler i trinnet for bidragsytere og i det siste gjennomgangstrinnet i innleveringsveiviseren, som minner forfattere av veiledede arbeider om å legge til veilederen sin som medforfatter, og krever en bekreftelse før innlevering. Alle tekster kan konfigureres og er flerspråklige."

#, fuzzy
msgid "plugins.generic.coauthorAlert.settings.description"
msgstr "Feltene nedenfor er forhåndsutfylt med en standardtekst på hvert av tidsskriftets språk og kan endres fritt. Hvis et felt står tomt, brukes standardteksten til programtillegget."

