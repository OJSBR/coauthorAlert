#, fuzzy
msgid "plugins.generic.coauthorAlert.default.contributorsAlertTitle"
msgstr "Ohjattu työ? Lisää ohjaajasi kanssakirjoittajaksi nyt"

#, fuzzy
msgid "plugins.generic.coauthorAlert.default.contributorsAlertText"
msgstr "<p>Onko kyseessä ohjattu työ (lopputyö, opinnäytetyö tai kandidaatintutkielma)? Lisää ohjaajasi kanssakirjoittajaksi <strong>tässä vaiheessa</strong>.</p><p>Lähettämisen jälkeen kirjoittajaluetteloa ei voi muuttaa, ja julkaisun on tiedettävä alusta asti, kuka ohjaajasi on, jotta häntä ei koskaan kutsuta arvioimaan oman opiskelijansa työtä, mikä vaarantaisi kaksoissokkoarvioinnin. Ilman ohjaajaa kanssakirjoittajana työtä ei myöskään voida hyväksyä lopputyöksi.</p>"

#, fuzzy
msgid "plugins.generic.coauthorAlert.default.soloWarning"
msgstr "Tällä käsikirjoituksella on vain yksi kirjoittaja. Jos työ on tehty ohjauksessa, lisää ohjaajasi kanssakirjoittajaksi nyt."

#, fuzzy
msgid "plugins.generic.coauthorAlert.default.soloOk"
msgstr "Kanssakirjoittajia lisätty. Varmista, että ohjaajasi on heidän joukossaan."

#, fuzzy
msgid "plugins.generic.coauthorAlert.default.reviewAlertTitle"
msgstr "Viimeinen tilaisuus lisätä ohjaajasi kanssakirjoittajaksi"

#, fuzzy
msgid "plugins.generic.coauthorAlert.default.reviewAlertText"
msgstr "<p>Lähettämisen jälkeen kirjoittajaluetteloa ei voi enää muuttaa. Jos työ on tehty ohjauksessa eikä ohjaajasi ole yllä, napsauta Muokkaa Tekijät-paneelissa: muuten työtä ei voida hyväksyä lopputyöksi, ja ohjaajasi voidaan kutsua arvioimaan se, mikä vaarantaa kaksoissokkoarvioinnin.</p>"

#, fuzzy
msgid "plugins.generic.coauthorAlert.default.confirmLabel"
msgstr "<p>Olen tarkistanut kirjoittajaluettelon. Jos tämä työ on tehty ohjauksessa, ohjaajani on merkitty kanssakirjoittajaksi. Ymmärrän, ettei kanssakirjoittajia voi lisätä lähettämisen jälkeen.</p>"

#, fuzzy
msgid "plugins.generic.coauthorAlert.default.confirmError"
msgstr "Rastita yllä oleva vahvistus viimeistelläksesi lähetyksen."
